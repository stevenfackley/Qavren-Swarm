<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>QavrenSwarm</RootNamespace>
    <AssemblyName>QavrenSwarm</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
    <ServerGarbageCollection>false</ServerGarbageCollection>
  </PropertyGroup>

  <!-- Kestrel (broker) comes from the Web SDK's implicit Microsoft.AspNetCore.App ref. -->
  <ItemGroup>
    <PackageReference Include="ModelContextProtocol" Version="2.1.0" />
    <PackageReference Include="Docker.DotNet" Version="3.125.15" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="QavrenSwarm.Tests" />
  </ItemGroup>

  <!-- The test project lives under tests/; keep its sources out of this app's compile. -->
  <ItemGroup>
    <Compile Remove="tests\**\*.cs" />
    <Content Remove="tests\**" />
  </ItemGroup>

  <!-- Agent build context shipped inside the assembly so images build with no external files. -->
  <ItemGroup>
    <EmbeddedResource Include="Agent\Dockerfile.node" LogicalName="qavren.agent.Dockerfile.node" />
    <EmbeddedResource Include="Agent\Dockerfile.python" LogicalName="qavren.agent.Dockerfile.python" />
    <EmbeddedResource Include="Agent\agent.py" LogicalName="qavren.agent.agent.py" />
    <EmbeddedResource Include="Agent\requirements.txt" LogicalName="qavren.agent.requirements.txt" />
  </ItemGroup>

</Project>
