# Qavren Swarm ephemeral agent — Python 3.12 runtime.
# The container is disposable: it copies the mounted (read-only) workspace,
# lets the model edit the copy, runs tests, and prints a git diff to stdout.
FROM python:3.12-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends git \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir -r /app/requirements.txt
COPY agent.py /app/agent.py

# Run as a non-root user; the writable working copy lives under /tmp.
RUN useradd --create-home --uid 1000 agent
USER agent
ENV HOME=/home/agent PYTHONUNBUFFERED=1
ENTRYPOINT ["python3", "/app/agent.py"]
